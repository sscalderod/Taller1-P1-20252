# Copia este archivo como .env y completa los valores (.env no se sube al repositorio)

# Clave secreta de Django. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True solo en desarrollo local
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma (agrega la IP o dominio del servidor al desplegar)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
